# /etc/planet-api.env —— planet-api systemd EnvironmentFile 模板
# 生产必改项：PLANET_ENV=prod、强随机密码、RESEND_API_KEY
PLANET_ENV=prod
BIND=127.0.0.1:8081
DATABASE_URL=host=/var/run/postgresql dbname=planet user=planet_app password=CHANGE_ME_APP
RESEND_API_KEY=
MAIL_FROM=PLANET <code@mail.joinplanet.pet>
BASE_URL=https://api.joinplanet.pet
LOG_LEVEL=info
# 主动服务调度器（提醒/每日摘要/预警 + 当日照护数据的兜底物化）。
# 生产必须开启：不开启则不发送任何通知，且趋势统计对无人活跃的日子结构性失真。
PLANET_SCHEDULER=1
# Web 分享页/Expo Web 调试来源，逗号分隔（原生 APP 无需）
CORS_ORIGINS=https://www.joinplanet.pet,https://app.joinplanet.pet
# 备份验收：本地副本目录 + 异地 S3/R2 URI。prod-preflight 会拒绝缺任一项。
# 运行 planet-cli backup 前确认 bucket 生命周期与恢复演练已完成。
BACKUP_DIR=/var/lib/planet-api/backups
BACKUP_S3_URI=s3://replace-me/planet-api
# DEV_AUTH_CODES=1 在 prod 会被启动检查拒绝（保留此行注释作提醒）
# 迁移凭据（DDL 角色密码）不放本文件：常驻服务进程不应持有迁移权限。
# 部署时使用 /etc/planet-api-owner.env（模板见 deploy/planet-owner.env.example，
# 权限 0600 root:root），deploy.sh 会单独 source 它。
