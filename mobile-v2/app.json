{
  "expo": {
    "name": "PLANET",
    "slug": "planet-mobile-v2",
    "version": "2.0.0",
    "scheme": "planet",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E8"
    },
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pet.joinplanet.app"
    },
    "android": {
      "package": "pet.joinplanet.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F1E8"
      },
      "predictiveBackGestureEnabled": true
    }
  }
}
