# Leave this blank for local development. The app derives the API host from
# Expo's runtime host, so Web uses localhost and a phone uses the Mac's LAN IP.
# `../scripts/dev-app.sh` injects the LAN URL explicitly for Expo Go.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_PUBLIC_WEB_BASE_URL=https://www.joinplanet.pet
EXPO_PUBLIC_ENABLE_PREVIEW=false
