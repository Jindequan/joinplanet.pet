{
  "name": "planet-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer} expo start --port 8082",
    "postinstall": "node scripts/patch-react-navigation-web.cjs",
    "ios": "../scripts/ios.sh",
    "android": "bash ../scripts/android-emulator.sh",
    "typecheck": "node --stack_size=8192 node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "doctor": "npx expo-doctor",
    "export:web": "expo export --platform web",
    "export:web:production": "EXPO_NO_DOTENV=1 NODE_ENV=production EXPO_PUBLIC_API_BASE_URL=\"${EXPO_PUBLIC_API_BASE_URL:-https://api.joinplanet.pet/api/v1}\" EXPO_PUBLIC_PUBLIC_WEB_BASE_URL=\"${EXPO_PUBLIC_PUBLIC_WEB_BASE_URL:-https://www.joinplanet.pet}\" node scripts/check-web-production-env.cjs && EXPO_NO_DOTENV=1 NODE_ENV=production EXPO_PUBLIC_API_BASE_URL=\"${EXPO_PUBLIC_API_BASE_URL:-https://api.joinplanet.pet/api/v1}\" EXPO_PUBLIC_PUBLIC_WEB_BASE_URL=\"${EXPO_PUBLIC_PUBLIC_WEB_BASE_URL:-https://www.joinplanet.pet}\" expo export --platform web --clear",
    "verify:frontend": "bash ../scripts/verify-frontend-product-contracts.sh",
    "preflight:release": "bash ../scripts/mobile-release-preflight.sh",
    "test:e2e": "playwright test"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.0",
    "dayjs": "^1.11.13",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "~19.1.0",
    "eslint": "^9.39.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "metro": {
      "image-size": "npm:@josuejuca/image-size@2.0.7"
    },
    "postcss": "8.5.28",
    "uuid": "11.1.1"
  }
}
