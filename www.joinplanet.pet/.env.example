# PLANET landing page (Vercel frontend) — public env vars only.
# All server secrets (Lemon API key, signing secret, claim token, DATABASE_URL)
# live on the Go backend, NOT here.

# Origin of the Go backend that serves /checkout, /progress, /intake,
# /email-capture, /webhook, /membership/claim. Empty = same-origin (local proxy).
# Example: https://api.joinplanet.pet
NEXT_PUBLIC_API_BASE=

# Display-only current cohort price, injected at build time into the landing page.
# If omitted, the landing page uses the launch default of S$29.99.
NEXT_PUBLIC_LIFETIME_PRICE_DISPLAY=

# Optional Google Analytics 4 measurement ID (G-XXXXXXX). When empty, no GA
# scripts or click events are emitted.
NEXT_PUBLIC_GA_ID=
