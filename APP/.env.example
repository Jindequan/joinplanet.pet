# Leave this blank for local development. The app derives the API host from
# Expo's runtime host; Web and the local Simulator/Emulator scripts use loopback.
# Physical-device mode is disabled in the repository scripts.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_PUBLIC_WEB_BASE_URL=https://www.joinplanet.pet
EXPO_PUBLIC_ENABLE_PREVIEW=false
# Required for Expo push-token registration in preview/production builds.
# Do not invent this value; copy the projectId from the owning EAS project.
EXPO_PUBLIC_EAS_PROJECT_ID=
